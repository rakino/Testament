if has guix; then
    watch_file channels.lock
    PKGS="`
        `gnupg `
        `guile-newt `
        `guile-parted `
        `guile-webutils `
        `maak `
        `sops `
        `--development guix `
        `"
    eval "$(guix time-machine --channels=channels.lock -- shell --search-paths $PKGS)"
fi
