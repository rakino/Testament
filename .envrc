testament_path=$(pwd)
load_paths=${testament_path}/gen/modules:${testament_path}/src/modules

for dep in nonguix rosenthal sops-guix/modules; do
	load_paths=${load_paths}:${testament_path}/dep/${dep}
done

GUILE_LOAD_PATH=${load_paths}${GUILE_LOAD_PATH:+:}${GUILE_LOAD_PATH}
GUIX_PACKAGE_PATH=${load_paths}${GUIX_PACKAGE_PATH:+:}${GUIX_PACKAGE_PATH}
export GUILE_LOAD_PATH GUIX_PACKAGE_PATH testament_path
