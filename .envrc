if has guix; then
    use_guix --development guix
fi

testament_path=$(pwd -P)
guix_load_path=${testament_path}/dep/guix
extra_load_paths=${testament_path}/gen/modules:${testament_path}/src/modules
export testament_path

for dep in nonguix rosenthal sops-guix/modules; do
	extra_load_paths=${extra_load_paths}:${testament_path}/dep/${dep}
done

GUILE_LOAD_PATH=${extra_load_paths}${GUILE_LOAD_PATH:+:}${GUILE_LOAD_PATH}
GUIX_PACKAGE_PATH=${extra_load_paths}${GUIX_PACKAGE_PATH:+:}${GUIX_PACKAGE_PATH}
if [ -x ${guix_load_path}/scripts/guix ]; then
    GUILE_LOAD_COMPILED_PATH=${guix_load_path}${GUILE_LOAD_COMPILED_PATH:+:}${GUILE_LOAD_COMPILED_PATH}
    GUILE_LOAD_PATH=${guix_load_path}${GUILE_LOAD_PATH:+:}${GUILE_LOAD_PATH}
    GUIX=${guix_load_path}/dep/guix/scripts/guix
    GUIX_UNINSTALLED=1
    PATH=${guix_load_path}/scripts:${guix_load_path}:${PATH}
    export GUILE_LOAD_COMPILED_PATH GUIX GUIX_UNINSTALLED PATH
fi
export GUILE_LOAD_PATH GUIX_PACKAGE_PATH
